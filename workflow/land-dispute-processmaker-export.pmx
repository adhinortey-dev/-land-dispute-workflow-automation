        <dyn_filename><![CDATA[27544921766757a332a78c0043908190/3444169166681ab1ec09026013194227]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"lot form","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"3444169166681ab1ec09026013194227","name":"lot form","description":"","mode":"edit","script":{"type":"js","code":"// Determining & setting the current date value\n$(\"#request_date\").setValue(new Date().toJSON().slice(0,10));\n\n// OGC service URL (WFMS's exercise endpoint)\nvar owsUrl = 'https://gip.itc.utwente.nl/services/zones?';\n$(\"#ows_url\").setValue(owsUrl);\n\n// OpenStreetMap as a base layer\nvar osmLayer = new ol.layer.Tile({\n    className: 'bw40',\n    source: new ol.source.OSM()\n});\n\n// Layer to display the city's boundary\nvar cityLayer = new ol.layer.Image({\n    title: 'City',\n    source: new ol.source.ImageWMS({\n        url: owsUrl,\n        params: {\n            'LAYERS': 'city',\n            'STYLES': 'blackline',\n            serverType: 'mapserver'\n        }\n    })\n});\n\n// Vector layer containing the lots of a given district\nvar wfsParams = '&typename=wfms:lot&' +\n                'service=WFS&version=1.1.0&request=GetFeature' +\n                '&outputFormat=geojson&srsname=EPSG:3857';\nvar lotLayer = new ol.layer.Vector({\n    title: 'Lots',\n    source: new ol.source.Vector({\n        format: new ol.format.GeoJSON(),\n        url: owsUrl + wfsParams\n    }),\n    style: new ol.style.Style({\n        stroke: new ol.style.Stroke({\n            color: 'rgb(100, 149, 237)',\n            width: 2.5\n        }),\n        fill: new ol.style.Fill({\n            color: 'rgba(100, 149, 237, 0.1)'\n        })\n    })\n});\n\n// Creating the map object, adding the layers, and setting the map's center, zoom level & extent\nvar navmap = new ol.Map({\n    target: 'navmap_div',\n    layers: [osmLayer, cityLayer, lotLayer],\n    view: new ol.View({\n        extent: ol.proj.transformExtent([6.6104, 52.1542, 7.1531, 52.2922], 'EPSG:4326', 'EPSG:3857'),\n        center: ol.proj.transform([6.8819, 52.2232], 'EPSG:4326', 'EPSG:3857'),\n        zoom: 11.5, minZoom: 11, maxZoom: 16\n    })\n});\n\n// Specifying a layer to store user-created input\nvar aoiLayer = new ol.layer.Vector({\n    source: new ol.source.Vector(),\n    style: new ol.style.Style({\n        stroke: new ol.style.Stroke({\n            color: 'rgb(230, 0, 119)',\n            width: 2\n        }),\n        fill: new ol.style.Fill({\n            color: 'rgba(230, 0, 119, 0.4)'\n        })\n    })\n});\nnavmap.addLayer(aoiLayer);\n\n// Creating an interaction object for on-screen digitizing\nvar drawPolygon = new ol.interaction.Draw({\n    source: aoiLayer.getSource(),\n    type: 'Polygon'\n});\ndrawPolygon.on('drawstart', function() {\n    // Do not clear previous features\n});\nnavmap.addInteraction(drawPolygon);\n\n// Creating an interaction object to collect point data from the user\nvar point = new ol.interaction.Draw({\n    source: aoiLayer.getSource(),\n    type: 'Point',\n});\npoint.on('drawstart', function(){\n    aoiLayer.getSource().clear();\n});\nnavmap.addInteraction(point);\n\n// Specifying what to do when user input is detected\naoiLayer.getSource().on('addfeature', function(event){\n    var feature = event.feature;\n    var coords = feature.getGeometry().clone().transform('EPSG:3857','EPSG:4326').getCoordinates();\n    $(\"#aoi_coords\").setValue(coords[0][0] + ' ' + coords[0][1]);\n});\n\n// Ensure lots are visible and selectable from the start\nlotLayer.getSource().once('change', function(){\n    var extent = lotLayer.getSource().getExtent();\n    navmap.getView().fit(extent, { size: navmap.getSize(), maxZoom: 16 });\n});\n\n// Define an interaction object to select lots\nvar lotSelection = new ol.interaction.Select({\n    layers: [lotLayer],\n    style: function(feature){\n        return new ol.style.Style({\n            fill: new ol.style.Fill({\n                color: 'rgba(166, 77, 255, 0.1)'\n            }),\n            stroke: new ol.style.Stroke({\n                color: 'rgb(166, 77, 255)',\n                width: 2.5\n            }),\n            text: new ol.style.Text({\n                text: feature.getProperties().lot_code,\n                textAlign: 'center',\n                font: 'Normal 16px Calibri,sans-serif',\n                overflow: true,\n                fill: new ol.style.Fill({color: 'rgb(128, 0, 255)'}),\n                stroke: new ol.style.Stroke({color: 'rgba(255, 255, 255, 0.5)', width: 3})\n            }),\n            zIndex: 10\n        });\n    }\n});\nnavmap.addInteraction(lotSelection);\n\n// Specifying what to do when lot is selected/unselected\nlotSelection.getFeatures().on('add', function(evt){\n    $(\"#selected_lot\").setValue(evt.element.getProperties().lot_code);\n    $(\"#district_name\").setValue(evt.element.getProperties().district_name);\n    var lotSize = evt.element.getProperties().lot_size;\n    $(\"#lot_size\").setValue((lotSize/10000).toFixed(1) + ' Hectares.');\n});\nlotSelection.getFeatures().on('remove', function(evt){\n    $(\"#selected_lot\").setValue('');\n    $(\"#lot_size\").setValue('');\n});\n"},"language":"en","externalLibs":"https://gip.itc.utwente.nl/exercises/styles/wfms.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.js\n","printable":false,"items":[[{"type":"title","id":"t__allocation_form","label":"Lot Allocation","ariaLabel":"","colSpan":12}],[{"type":"textarea","variable":"description","var_uid":"54095880066788217158ee6008914338","dataType":"string","protectedValue":false,"id":"description","name":"description","label":"Request Description","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"description","colSpan":12}],[{"colSpan":2},{"type":"panel","id":"map_panel","content":"<div id=\"navmap_div\" style=\"height:500px; border:1px solid #aaa; padding:5px;\"></div>","border":"1px","colSpan":10}],[{"type":"text","variable":"aoi_coords","var_uid":"83679298666788172c6de47038379881","dataType":"string","protectedValue":false,"id":"aoi_coords","name":"aoi_coords","label":"Aoi coordinates","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"aoi_coords","colSpan":6},{"type":"datetime","variable":"request_date","var_uid":"7200002596679b83628a544074990760","dataType":"datetime","protectedValue":false,"id":"request_date","name":"request_date","label":"Request Date","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"view","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"request_date","colSpan":6}],[{"type":"text","variable":"selected_lot","var_uid":"98738357766788d1129efc4077364267","dataType":"string","protectedValue":false,"id":"selected_lot","name":"selected_lot","label":"Selected Lot:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"selected_lot","colSpan":6},{"type":"text","variable":"lot_size","var_uid":"21332748166788d35a76836084948598","dataType":"string","protectedValue":false,"id":"lot_size","name":"lot_size","label":"Lot Size:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"lot_size","colSpan":6}],[{"type":"text","variable":"district_name","var_uid":"55962324766788d75c06131077134744","dataType":"string","protectedValue":false,"id":"district_name","name":"district_name","label":"District Name","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"district_name","colSpan":12}],[{"type":"submit","id":"submit_selection","name":"Submit Selection","label":"Submit Selection","tabIndex":"","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"ows_url","var_uid":"957748976667884594ece53065968267","dataType":"string","protectedValue":false,"id":"ows_url","name":"ows_url","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"ows_url","colSpan":12}],[{"type":"hidden","variable":"ows_extent","var_uid":"55953520666788e0b094330032831755","dataType":"string","protectedValue":false,"id":"ows_extent","name":"ows_extent","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"ows_extent","colSpan":12}]],"variables":[{"var_uid":"54095880066788217158ee6008914338","prj_uid":"27544921766757a332a78c0043908190","var_name":"description","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"35941261866678d96b64022033599429","var_name_old":"description","prj_uid_old":"32990997066677a1dc25167096211348","create":false},{"var_uid":"83679298666788172c6de47038379881","prj_uid":"27544921766757a332a78c0043908190","var_name":"aoi_coords","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"6371847026667890f082613023315457","var_name_old":"aoi_coords","prj_uid_old":"32990997066677a1dc25167096211348","create":false},{"var_uid":"7200002596679b83628a544074990760","prj_uid":"27544921766757a332a78c0043908190","var_name":"request_date","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"7748399936667899d4deaf9014456139","var_name_old":"request_date","prj_uid_old":"32990997066677a1dc25167096211348","create":false},{"var_uid":"98738357766788d1129efc4077364267","prj_uid":"27544921766757a332a78c0043908190","var_name":"selected_lot","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"63981539966679ef7396dc1009984406","var_name_old":"selected_lot","prj_uid_old":"32990997066677a1dc25167096211348","create":false},{"var_uid":"21332748166788d35a76836084948598","prj_uid":"27544921766757a332a78c0043908190","var_name":"lot_size","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"89581289666679f34c96e10086903858","var_name_old":"lot_size","prj_uid_old":"32990997066677a1dc25167096211348","create":false},{"var_uid":"55962324766788d75c06131077134744","prj_uid":"27544921766757a332a78c0043908190","var_name":"district_name","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"957748976667884594ece53065968267","prj_uid":"27544921766757a332a78c0043908190","var_name":"ows_url","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"37452910766678ecbd65935097630567","var_name_old":"ows_url","prj_uid_old":"32990997066677a1dc25167096211348","create":false},{"var_uid":"55953520666788e0b094330032831755","prj_uid":"27544921766757a332a78c0043908190","var_name":"ows_extent","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"68793531866679fa3b673f4010025091","var_name_old":"ows_extent","prj_uid_old":"32990997066677a1dc25167096211348","create":false}]}]}]]></dyn_content>
