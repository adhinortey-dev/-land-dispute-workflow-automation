    <table name="triggers">
      <record>
        <tri_uid>1694695926676b0b598d976005263150</tri_uid>
        <tri_title>RecommendationPerformer</tri_title>
        <tri_description></tri_description>
        <pro_uid>27544921766757a332a78c0043908190</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[@@AnalysisPerformer = @@USER_LOGGED;]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>2256696306676b83734a5f7011130022</tri_uid>
        <tri_title>DataAnalystChoice</tri_title>
        <tri_description></tri_description>
        <pro_uid>27544921766757a332a78c0043908190</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[if (@@disputetype == 'bound' || @@disputetype == 'owner') {
    // Assignment for Boundary/Ownership disputetype
    $nextUser = 'rickhanks';
} else {
    // Assignment for Inheritance/Easement/other disputetype
    $nextUser = 'lindaclark';
}

// find the UID for the chosen user in ProcessMaker's MySQL database
$result = executeQuery("SELECT USR_UID FROM USERS WHERE USR_USERNAME='$nextUser'");
@@DataAnalyst = $result[1]['USR_UID'];
]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>2418193946676c53bea0af2012701658</tri_uid>
        <tri_title>LotImage</tri_title>
        <tri_description></tri_description>
        <pro_uid>27544921766757a332a78c0043908190</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[if (@=require == 2 or @=update == 2) {
    // Values for a selected area
    $layers = 'lot,disputetype';
    $areaGeom = '';
} else {
    // Values for a surveyed lot
	$layers= 'distric_name,surveyed_lot';
	$lotGeom = '{"type":"Polygon","coordinates":[' . @=survey_coords . ']}';
}

// URL of the area image as a WMS request
@@lot_wms = '<img src="https://gip.itc.utwente.nl/services/zones?SERVICE=WMS' .
                  '&VERSION=1.3.0&REQUEST=GetMap&FORMAT=image%2Fpng&TRANSPARENT=true' .
                  '&STYLES=&serverType=mapserver&CRS=EPSG%3A3857&WIDTH=714&HEIGHT=366' .
                  '&BBOX=' . @=ows_extent .
                  '&LAYERS=' . $layers .
                  '&LOTCODE=' . @=selected_lot .
                  '&COORDS=' . @=aoi_coords .
                  '&LOTGEOM=' . urlencode($areaGeom) .
                  '" style="object-fit:contain;" width="400" height="200" />';
]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>5509700236676ada8c2ffc7069724140</tri_uid>
        <tri_title>CustomerData</tri_title>
        <tri_description></tri_description>
        <pro_uid>27544921766757a332a78c0043908190</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[$userData = userInfo(@@USER_LOGGED);
@@customer_name = $userData['firstname'] . ' ' . $userData['lastname'];
@@customer_email = $userData['mail'];]]></tri_webbot>
        <tri_param></tri_param>
      </record>
    </table>
