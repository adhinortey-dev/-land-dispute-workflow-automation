      <record>
        <dyn_uid>83255291866769cfc4e72b8029116729</dyn_uid>
        <dyn_title>update records</dyn_title>
        <dyn_description></dyn_description>
        <pro_uid>27544921766757a332a78c0043908190</pro_uid>
        <dyn_type>xmlform</dyn_type>
        <dyn_filename><![CDATA[27544921766757a332a78c0043908190/83255291866769cfc4e72b8029116729]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"update records","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"83255291866769cfc4e72b8029116729","name":"update records","description":"","mode":"edit","script":{"type":"js","code":"var owsUrl = ($('#ows_url').getValue());\nvar coords = ($('#aoi_coords').getValue()).split(' ');\n\n\nvar osmLayer = new ol.layer.Tile({\n    className: 'bw100',\n    source: new ol.source.OSM()\n});\n\n\nvar districtLayer = new ol.layer.Tile({\n    title: 'Districts',\n    source: new ol.source.TileWMS({\n        url: owsUrl,\n        params: {\n            'LAYERS': 'district',\n            serverType: 'mapserver'\n        }\n    })\n});\n\n\n// Vector layer for the boundary of the district where the survey takes place\nvar wfsParams = '&typename=wfms:survey_district' +\n                '&service=WFS&version=1.1.0&request=GetFeature' +\n                '&outputFormat=geojson&srsname=EPSG:3857';\nvar surveyAreaLayer = new ol.layer.Vector({\n    title: 'Survey District',\n    source: new ol.source.Vector({\n        format: new ol.format.GeoJSON(),\n        url: owsUrl + wfsParams + '&COORDS=' + coords[0] + ' ' + coords[1]\n    }),\n    style: new ol.style.Style({\n        stroke: new ol.style.Stroke({\n            color: 'rgb(100, 149, 237)',\n            width: 2.5\n        }),\n        fill: new ol.style.Fill({\n            color: 'rgba(100, 149, 237, 0.1)'\n        })\n    })\n});\n\n\n// Compute the survey district's bounding box and store the value in the 'ows_extent' variable\nvar districtCode, recenter = true;\nsurveyAreaLayer.getSource().on('change', function(){\n    if (recenter){\n        var extent = this.getExtent();\n        navmap.getView().setCenter(ol.extent.getCenter(extent));\n        navmap.getView().fit(extent, navmap.getSize());\n        navmap.getView().setZoom(navmap.getView().getZoom() - 0.3);\n        $(\"#ows_extent\").setValue((navmap.getView().calculateExtent(navmap.getSize())).toString());\n\n        $(\"#district_name\").setValue(this.getFeatures()[0].getProperties().district_name);\n        districtCode = this.getFeatures()[0].getProperties().district_code;\n        recenter = false;\n    }\n});\n\n\n// Vector layer for survey data\nvar lotLayer = new ol.layer.Vector({\n    title: 'Survey',\n    source: new ol.source.Vector(),\n    style: new ol.style.Style({\n        fill: new ol.style.Fill({\n            color: 'rgba(166, 77, 255, 0.1)'\n        }),\n        stroke: new ol.style.Stroke({\n            color: 'rgb(166, 77, 255)',\n            width: 2.5\n        }),\n        zIndex: 10\n    })\n});\n\n\nvar navmap = new ol.Map({\n    layers: [osmLayer, districtLayer, surveyAreaLayer, lotLayer],\n    target: 'navmap_div',\n    view: new ol.View({\n        extent: ol.proj.transformExtent([6.6104, 52.1542, 7.1531, 52.2922], 'EPSG:4326', 'EPSG:3857'),\n        center: ol.proj.transform([6.8819, 52.2232], 'EPSG:4326', 'EPSG:3857'),\n        zoom: 12, minZoom: 11, maxZoom: 16\n    })\n});\n\n\n// Define a interaction object for on-screen digitizing\nvar drawLot = new ol.interaction.Draw({\n    source: lotLayer.getSource(),\n    type: 'Polygon'\n});\ndrawLot.on('drawstart', function(){\n    lotLayer.getSource().clear();\n});\nnavmap.addInteraction(drawLot);\n\n\n// Enable snaping of the surveyed lot inputs to the district boundary\nnavmap.addInteraction(new ol.interaction.Snap({\n    source: surveyAreaLayer.getSource(),\n}));\n\n\n// Specifying what to do when a lot survey is completed\nvar lotSize;\nlotLayer.getSource().on('addfeature', function(){\n    var surveyCoords = $.extend(true, {}, this.getFeatures()[0].getGeometry());\n    surveyCoords = surveyCoords.transform('EPSG:3857','EPSG:4326');\n    $(\"#survey_coords\").setValue(JSON.stringify(surveyCoords.getCoordinates()[0]));\n\n    lotSize = ol.sphere.getArea(this.getFeatures()[0].getGeometry());\n    $(\"#lot_size\").setValue((Math.round((lotSize/10000)*100)/100).toString() + ' Hectares.');\n\n    $(\"#selected_lot\").setValue(districtCode + '-s' + (1 + Math.floor(Math.random() * 100)));\n});\n"},"language":"en","externalLibs":"https://gip.itc.utwente.nl/exercises/styles/wfms.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.js\n\n\n","printable":false,"items":[[{"type":"title","id":"t__reg_new","label":"Registration","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"t__update_details","label":"update details","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"t__area_of_interest","label":"Area of Interest","ariaLabel":"","colSpan":2},{"type":"panel","id":"map_panel","content":"<div id=\"navmap_div\" style=\"height:500px; border:1px solid #aaa; padding:5px;\"></div>","border":"1px","colSpan":10}],[{"type":"text","variable":"survey_coords","var_uid":"73948448166788d90d8ef69063520436","dataType":"string","protectedValue":false,"id":"survey_coords","name":"survey_coords","label":"Corrected Spot For Registration","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"survey_coords","colSpan":12}],[{"type":"text","variable":"lot_size","var_uid":"21332748166788d35a76836084948598","dataType":"string","protectedValue":false,"id":"lot_size","name":"lot_size","label":"Area Size","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"lot_size","colSpan":12}],[{"type":"label","id":"label0000000005","label":"Based On The Outcome Decision;","ariaLabel":"","colSpan":12}],[{"type":"checkbox","variable":"approval","var_uid":"1121071956676a35e2b93e7018851017","dataType":"boolean","protectedValue":false,"id":"dispute_status","name":"approval","label":"Dispute Is Resolved","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"var_name":"approval","colSpan":12}],[{"type":"radio","variable":"up","var_uid":"18582249866817e12af5046071977895","dataType":"boolean","protectedValue":false,"id":"up","name":"up","label":"New Update Must Be Registered","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"var_name":"up","colSpan":12}],[{"type":"checkbox","variable":"checkboxVar002","var_uid":"9095165906676a3ef5c8a44075630077","dataType":"boolean","protectedValue":false,"id":"issed_newdocumnet","name":"checkboxVar002","label":"New Documents to be Issued","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"var_name":"checkboxVar002","colSpan":12}],[{"type":"datetime","variable":"datetimeVar003","var_uid":"1732413396676a44fda2dd6066472797","dataType":"datetime","protectedValue":false,"id":"update_date","name":"datetimeVar003","label":"Date of Update","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"datetimeVar003","colSpan":12}],[{"type":"link","id":"link0000000001","name":"link0000000001","label":"Supposed LInk To Access neccessary Records For Update","tabIndex":"","value":"","href":"","hint":"","ariaLabel":"","colSpan":12}],[{"type":"submit","id":"submit_progress","name":"submit","label":"Issue Document And Submit","tabIndex":"","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"hidden","var_uid":"703859121667a939e0273f1001546376","dataType":"string","protectedValue":false,"id":"hidden","name":"hidden","defaultValue":"ows_url","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"hidden","colSpan":12}]],"variables":[{"var_uid":"73948448166788d90d8ef69063520436","prj_uid":"27544921766757a332a78c0043908190","var_name":"survey_coords","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"21332748166788d35a76836084948598","prj_uid":"27544921766757a332a78c0043908190","var_name":"lot_size","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"1121071956676a35e2b93e7018851017","prj_uid":"27544921766757a332a78c0043908190","var_name":"approval","var_field_type":"boolean","var_field_size":10,"var_label":"boolean","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"inp_doc_uid":""},{"var_uid":"18582249866817e12af5046071977895","prj_uid":"27544921766757a332a78c0043908190","var_name":"up","var_field_type":"boolean","var_field_size":10,"var_label":"boolean","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[{\"value\":\"1\",\"label\":\"true\"},{\"value\":\"0\",\"label\":\"false\"}]","inp_doc_uid":""},{"var_uid":"9095165906676a3ef5c8a44075630077","prj_uid":"27544921766757a332a78c0043908190","var_name":"checkboxVar002","var_field_type":"boolean","var_field_size":10,"var_label":"boolean","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[{\"value\":\"1\",\"label\":\"true\"},{\"value\":\"0\",\"label\":\"false\"}]","inp_doc_uid":""},{"var_uid":"1732413396676a44fda2dd6066472797","prj_uid":"27544921766757a332a78c0043908190","var_name":"datetimeVar003","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"703859121667a939e0273f1001546376","prj_uid":"27544921766757a332a78c0043908190","var_name":"hidden","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
