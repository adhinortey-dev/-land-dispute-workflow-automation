      <record>
        <dyn_uid>960451866667824ee52fd11074660527</dyn_uid>
        <dyn_title>Mutual Agreement Form</dyn_title>
        <dyn_description></dyn_description>
        <pro_uid>27544921766757a332a78c0043908190</pro_uid>
        <dyn_type>xmlform</dyn_type>
        <dyn_filename><![CDATA[27544921766757a332a78c0043908190/960451866667824ee52fd11074660527]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"Mutual Agreement Form","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"960451866667824ee52fd11074660527","name":"Mutual Agreement Form","description":"","mode":"edit","script":{"type":"js","code":"var owsUrl = $('#ows_url').getValue();\nvar coords = ($('#aoi_coords').getValue()).split(' ');\n\n\nvar osmLayer = new ol.layer.Tile({\n    className: 'bw100',\n    source: new ol.source.OSM()\n});\n\n\n// Layer to display district boundaries\nvar districtLayer = new ol.layer.Tile({\n    title: 'Districts',\n    source: new ol.source.TileWMS({\n        url: owsUrl,\n        params: {\n            'LAYERS': 'district',\n            serverType: 'mapserver'\n        }\n    })\n});\n\n\n// Vector layer containing the lots of a given district\nvar wfsParams = '&typename=wfms:lot&' +\n                'service=WFS&version=1.1.0&request=GetFeature' +\n                '&outputFormat=geojson&srsname=EPSG:3857';\nvar lotLayer = new ol.layer.Vector({\n    title: 'Lots',\n    source: new ol.source.Vector({\n        format: new ol.format.GeoJSON(),\n        url: owsUrl + wfsParams + '&COORDS=' + coords[0] + ' ' + coords[1]\n    }),\n    style: new ol.style.Style({\n        stroke: new ol.style.Stroke({\n            color: 'rgb(100, 149, 237)',\n            width: 2.5\n        }),\n        fill: new ol.style.Fill({\n            color: 'rgba(100, 149, 237, 0.1)'\n        })\n    })\n});\n\n\nvar navmap = new ol.Map({\n    layers: [osmLayer, districtLayer, lotLayer],\n    target: 'navmap_div',\n    view: new ol.View({\n        extent: ol.proj.transformExtent([6.6104, 52.1542, 7.1531, 52.2922], 'EPSG:4326', 'EPSG:3857'),\n        center: ol.proj.transform([6.8819, 52.2232], 'EPSG:4326', 'EPSG:3857'),\n        zoom: 12, minZoom: 11, maxZoom: 16\n    })\n});\n\n\n// Center the map and zoom to the extent of the set of available lots (should happen only once)\nvar recenter = true;\nlotLayer.getSource().on('change', function(){\n    if (recenter){\n        var extent = this.getExtent();\n        navmap.getView().setCenter(ol.extent.getCenter(extent));\n        navmap.getView().fit(extent, navmap.getSize());\n        navmap.getView().setZoom(navmap.getView().getZoom() - 0.3);\n        $(\"#ows_extent\").setValue((navmap.getView().calculateExtent(navmap.getSize())).toString());\n        recenter = false;\n    }\n});\n\n\n// Define an interaction object to select lots\nvar lotSelection = new ol.interaction.Select({\n    layers: [lotLayer],\n    condition: ol.events.condition.click,\n    style: function(feature){\n        return new ol.style.Style({\n            fill: new ol.style.Fill({\n                color: 'rgba(166, 77, 255, 0.1)'\n            }),\n            stroke: new ol.style.Stroke({\n                color: 'rgb(166, 77, 255)',\n                width: 2.5\n            }),\n            text: new ol.style.Text({\n                text: feature.getProperties().lot_code,\n                textAlign: 'center',\n                font: 'Normal 16px Calibri,sans-serif',\n                overflow: true,\n                fill: new ol.style.Fill({color: 'rgb(128, 0, 255)'}),\n                stroke: new ol.style.Stroke({color: 'rgba(255, 255, 255, 0.5)', width: 3})\n            }),\n            zIndex: 10\n        })\n    }\n});\nnavmap.addInteraction(lotSelection);\n\n\n// Specifying what to do when lot is selected/unselected\nlotSelection.getFeatures().on('add', function(evt){\n    $(\"#selected_lot\").setValue(evt.element.getProperties().lot_code);\n    $(\"#district_name\").setValue(evt.element.getProperties().district_name);\n    var lotSize = evt.element.getProperties().lot_size;\n    $(\"#lot_size\").setValue((lotSize/10000).toFixed(1) + ' Hectares.');\n});\nlotSelection.getFeatures().on('remove', function(evt){\n    $(\"#selected_lot\").setValue('');\n    $(\"#lot_size\").setValue('');\n});"},"language":"en","externalLibs":"https://gip.itc.utwente.nl/exercises/styles/wfms.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.js\n","printable":false,"items":[[{"type":"title","id":"t__preliminary_form","label":"Mediation Forms","ariaLabel":"","colSpan":12}],[{"type":"textarea","variable":"specific","var_uid":"551668219668160eec44ec6005985233","dataType":"string","protectedValue":false,"id":"specific","name":"specific","label":"Customer Description","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"specific","colSpan":12}],[{"type":"subtitle","id":"t___area_of_interest","label":"Area of Interest","ariaLabel":"","colSpan":2},{"type":"panel","id":"map_panel","content":"<div id=\"navmap_div\" style=\"height:500px; border:1px solid #aaa; padding:5px;\"></div>\n<div id=\"legend_div\" style=\"padding-top:5px;\"><img id=\"legend\" src=\"\"></div>","border":"1px","colSpan":10}],[{"type":"text","variable":"aoi_coords","var_uid":"83679298666788172c6de47038379881","dataType":"string","protectedValue":false,"id":"aoi_coords","name":"aoi_coords","label":"Aoi Coords","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"aoi_coords","colSpan":6},{"type":"datetime","variable":"request_date","var_uid":"7200002596679b83628a544074990760","dataType":"datetime","protectedValue":false,"id":"request_date","name":"request_date","label":"Request Date","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"view","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"request_date","colSpan":6}],[{"type":"subtitle","id":"t__analysis_results","label":"Results","ariaLabel":"","colSpan":12}],[{"type":"radio","variable":"disputetype","var_uid":"639249153667881b3c67496012019849","dataType":"string","protectedValue":false,"id":"disputetype","name":"disputetype","label":"Disputetype","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":false,"required":false,"requiredFieldErrorMessage":"","mode":"view","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"bound","label":"Boundary"},{"value":"owner","label":"Ownership"},{"value":"inherit","label":"Inheritance"},{"value":"ease","label":"Easement"},{"value":"other","label":"Others"}],"var_name":"disputetype","colSpan":6},{"type":"text","variable":"party_involved","var_uid":"612221992667881c60406f9007563854","dataType":"string","protectedValue":false,"id":"party_involved","name":"party_involved","label":"Party Involved","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":