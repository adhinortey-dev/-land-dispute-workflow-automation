<td width="2%" valign="top">
<p>&nbsp;</p>
</td>
<td colspan="2" width="75%">
<p><br /><font size="2" face="helvetica"><b>Valid from:</b> @#request_date</font></p>
<p>&nbsp;</p>
</td>
</tr>
<tr>
<td width="22%" valign="top">
<p><font face="helvetica"><b>New Title Deed:</b><br /> <font size="2">@=customer_name<br />@=customer_email</font></font></p>
<p><font face="helvetica"><b>Lot:</b><br /> <font size="2">@=selected_lot<br />@=lot_size</font></font></p>
<p><font face="helvetica"><b>District:</b><br /> <font size="2">@=district_name</font></font></p>
<p><font face="helvetica"><b>&nbsp;</b></font></p>
<p><font face="helvetica"><font size="2">&nbsp;</font></font></p>
