        <dyn_filename><![CDATA[27544921766757a332a78c0043908190/363969288667681f99b7788014122720]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"PreliminaryForm","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"363969288667681f99b7788014122720","name":"PreliminaryForm","description":"","mode":"edit","script":{"type":"js","code":"// Retrieve values from process variables\nvar owsUrl = $('#ows_url').getValue();\nvar coords = ($('#aoi_coords').getValue()).split(' ');\n\n\nvar osmLayer = new ol.layer.Tile({\n    className: 'bw100',\n    source: new ol.source.OSM()\n});\n\n\n// Layer to display the availability zones\nvar zoneLayer = new ol.layer.Tile({\n    title: 'Zone',\n    source: new ol.source.TileWMS({\n        url: owsUrl,\n        params: {\n            'LAYERS': 'zone',\n            'COORDS': coords[0] + ' ' + coords[1],\n            serverType: 'mapserver'\n        }\n    })\n});\n\n\nvar aoiLayer = new ol.layer.Vector({\n    source: new ol.source.Vector(),\n    style: new ol.style.Style({\n        image: new ol.style.Circle({\n            radius: 5,\n            fill: new ol.style.Fill({\n                color: 'rgba(230, 0, 119, 0.4)'\n            }),\n            stroke: new ol.style.Stroke({\n                color: 'rgb(230, 0, 119)',\n                width: 1.5\n            })\n        })\n    })\n});\n\n\n// Adding a feature for the point selected by the applicant\naoiLayer.getSource().addFeature(\n    new ol.Feature({\n        geometry: new ol.geom.Point(ol.proj.fromLonLat([coords[0], coords[1]]))\n    })\n);\n\n\nvar navmap = new ol.Map({\n    layers: [osmLayer, zoneLayer, aoiLayer],\n    target: 'navmap_div',\n    view: new ol.View({\n        extent: ol.proj.transformExtent([6.6104, 52.1542, 7.1531, 52.2922], 'EPSG:4326', 'EPSG:3857'),\n        center: ol.proj.transform([6.8819, 52.2232], 'EPSG:4326', 'EPSG:3857'),\n        zoom: 12, minZoom: 11, maxZoom: 16\n    })\n});\n\n\n// Displaying the legend describing the zone types\nvar params = 'version=1.3.0&service=WMS&request=GetLegendGraphic&layer=zone' +\n             '&sld_version=1.1.0&format=image/png&STYLE=';\n$('#legend').attr('src', owsUrl + params);"},"language":"en","externalLibs":"https://gip.itc.utwente.nl/exercises/styles/wfms.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.js\n","printable":false,"items":[[{"type":"title","id":"t__preliminary_form","label":"preliminary assessment","ariaLabel":"","colSpan":12}],[{"type":"textarea","variable":"specific","var_uid":"551668219668160eec44ec6005985233","dataType":"string","protectedValue":false,"id":"specific","name":"specific","label":"Description","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"specific","colSpan":12}],[{"type":"subtitle","id":"t___area_of_interest","label":"Area of Interest","ariaLabel":"","colSpan":2},{"type":"panel","id":"map_panel","content":"<div id=\"navmap_div\" style=\"height:500px; border:1px solid #aaa; padding:5px;\"></div>\n<div id=\"legend_div\" style=\"padding-top:5px;\"><img id=\"legend\" src=\"\"></div>","border":"1px","colSpan":10}],[{"type":"text","variable":"selected_lot","var_uid":"98738357766788d1129efc4077364267","dataType":"string","protectedValue":false,"id":"selected_lot","name":"selected_lot","label":"Selected Lot","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"selected_lot","colSpan":4},{"type":"text","variable":"lot_size","var_uid":"21332748166788d35a76836084948598","dataType":"string","protectedValue":false,"id":"lot_size","name":"lot_size","label":"Lot Size","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"lot_size","colSpan":4},{"type":"text","variable":"district_name","var_uid":"55962324766788d75c06131077134744","dataType":"string","protectedValue":false,"id":"district_name","name":"district_name","label":"District Name","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"district_name","colSpan":4}],[{"type":"text","variable":"aoi_coords","var_uid":"83679298666788172c6de47038379881","dataType":"string","protectedValue":false,"id":"aoi_coords","name":"aoi_coords","label":"Aoi Coords","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"aoi_coords","colSpan":6},{"type":"datetime","variable":"request_date","var_uid":"7200002596679b83628a544074990760","dataType":"datetime","protectedValue":false,"id":"request_date","name":"request_date","label":"Request Date","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"view","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"request_date","colSpan":6}],[{"type":"radio","variable":"disputetype","var_uid":"639249153667881b3c67496012019849","dataType":"string","protectedValue":false,"id":"disputetype","name":"disputetype","label":"Disputetype","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":false,"required":false,"requiredFieldErrorMessage":"","mode":"view","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"bound","label":"Boundary"},{"value":"owner","label":"Ownership"},{"value":"inherit","label":"Inheritance"},{"value":"ease","label":"Easement"},{"value":"other","label":"Others"}],"var_name":"disputetype","colSpan":6},{"type":"text","variable":"party_involved","var_uid":"612221992667881c60406f9007563854","dataType":"string","protectedValue":false,"id":"party_involved","name":"party_involved","label":"Party Involved","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"party_involved","colSpan":6}],[{"type":"radio","variable":"sevi","var_uid":"7302351586681794d431d66046832087","dataType":"boolean","protectedValue":false,"id":"sevi","name":"sevi","label":"OR Apply Straight Away For Survey Services Option","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"view","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"Yes"},{"value":"0","label":"No"}],"var_name":"sevi","colSpan":12}],[{"type":"subtitle","id":"t__analysis_results","label":"Assessment Results","ariaLabel":"","colSpan":12}],[{"type":"label","id":"label0000000002","label":"Please Answer Which Applies","ariaLabel":"","colSpan":12}],[{"type":"radio","variable":"addup","var_uid":"419471241667a28b09e03b2035484878","dataType":"boolean","protectedValue":false,"id":"addup","name":"addup","label":"Documents/Evidence Addup?","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"Yes"},{"value":"0","label":"No"}],"var_name":"addup","colSpan":6},{"type":"radio","variable":"approval","var_uid":"1121071956676a35e2b93e7018851017","dataType":"boolean","protectedValue":false,"id":"approval","name":"approval","label":"Approval For Further Investigation","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"Yes"},{"value":"0","label":"No"}],"var_name":"approval","colSpan":6}],[{"type":"radio","variable":"agreement","var_uid":"799433263667a2ee77cbf56006555413","