        <dyn_content><![CDATA[{"name":"recommendation","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"748748411667ab6c46ce070085075538","name":"recommendation","description":"","mode":"edit","script":"","language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"t__recommenadatio_form","label":"Recommnedation Form","ariaLabel":"","colSpan":12}],[{"type":"textarea","variable":"preliminary_assessment","var_uid":"5610136166678842a7ba270045934578","dataType":"string","protectedValue":false,"id":"preliminary_assessment","name":"preliminary_assessment","label":"Preliminary Assessment Report","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"preliminary_assessment","colSpan":12}],[{"type":"textarea","variable":"comment","var_uid":"194714905667a907c3c4c61071302209","dataType":"string","protectedValue":false,"id":"comment","name":"comment","label":"Report on Mediation","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"comment","colSpan":6},{"type":"textarea","variable":"outcome","var_uid":"175829421667a92998d32d1086405920","dataType":"string","protectedValue":false,"id":"outcome","name":"outcome","label":"Report on Investigation/Survey","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"outcome","colSpan":6}],[{"type":"suggest","variable":"suggesting","var_uid":"470614206667ab7beba7492023875919","dataType":"string","protectedValue":false,"id":"suggesting","name":"suggesting","label":"Reason For Notifying","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"1","label":"Processing Could Not Continue due to Evidence not adding up"},{"value":"2","label":"Taking non satisfactory investigation/mediation results to court"},{"value":"3","label":"Mediation Failed, Kindly Apply for Straight Away Survey"}],"delay":0,"resultsLimit":10,"forceSelection":false,"var_name":"suggesting","colSpan":12}],[{"type":"checkbox","variable":"notify","var_uid":"248224057667ab981e6c167018680795","dataType":"boolean","protectedValue":false,"id":"notify","name":"notify","label":"Notify Customer","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":false,"requiredFieldErrorMessage":"","mode":"parent","options":[{"value":"1","label":"true"},{"value":"0","label":"false"}],"var_name":"notify","colSpan":12}],[{"type":"submit","id":"submit_recommend","name":"submit_recommend","label":"Send Notification","tabIndex":"","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"hidden","var_uid":"703859121667a939e0273f1001546376","dataType":"string","protectedValue":false,"id":"ows_url","name":"hidden","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"hidden","colSpan":12}]],"variables":[{"var_uid":"5610136166678842a7ba270045934578","prj_uid":"27544921766757a332a78c0043908190","var_name":"preliminary_assessment","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"194714905667a907c3c4c61071302209","prj_uid":"27544921766757a332a78c0043908190","var_name":"comment","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"175829421667a92998d32d1086405920","prj_uid":"27544921766757a332a78c0043908190","var_name":"outcome","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"470614206667ab7beba7492023875919","prj_uid":"27544921766757a332a78c0043908190","var_name":"suggesting","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"248224057667ab981e6c167018680795","prj_uid":"27544921766757a332a78c0043908190","var_name":"notify","var_field_type":"boolean","var_field_size":10,"var_label":"boolean","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[{\"value\":\"1\",\"label\":\"true\"},{\"value\":\"0\",\"label\":\"false\"}]","inp_doc_uid":""},{"var_uid":"703859121667a939e0273f1001546376","prj_uid":"27544921766757a332a78c0043908190","var_name":"hidden","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
