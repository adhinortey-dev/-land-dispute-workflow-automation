e,"var_name":"date_resolution","colSpan":6}],[{"type":"radio","variable":"resolution_status","var_uid":"15355214766788607095608087297719","dataType":"string","protectedValue":true,"id":"resolution_status","name":"resolution_status","label":"Resolution Status","tabIndex":"","defaultValue":"","hint":"","ariaLabel":"","ariaLabelVisible":true,"required":true,"requiredFieldErrorMessage":"","mode":"parent","datasource":"database","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"dataVariable":"","options":[{"value":"new","label":"Issuance of New certificates"},{"value":"recommendation","label":"Return to Recommendation for Court Referral/  or Application for Survey"}],"var_name":"resolution_status","colSpan":12}],[{"type":"textarea","variable":"textareaVar002","var_uid":"8853789366676885025ae69084689116","dataType":"string","protectedValue":false,"id":"final_comment","name":"textareaVar002","label":"Final Comment","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"textareaVar002","colSpan":12}],[{"type":"submit","id":"submit_analysis","name":"submit_analysis","label":"submit result","tabIndex":"","ariaLabel":"","colSpan":12}],[{"type":"hidden","variable":"ows_url","var_uid":"957748976667884594ece53065968267","dataType":"string","protectedValue":false,"id":"ows_url","name":"hiddenVar001","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"ows_url","colSpan":12}]],"variables":[{"var_uid":"551668219668160eec44ec6005985233","prj_uid":"27544921766757a332a78c0043908190","var_name":"specific","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"83679298666788172c6de47038379881","prj_uid":"27544921766757a332a78c0043908190","var_name":"aoi_coords","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"7200002596679b83628a544074990760","prj_uid":"27544921766757a332a78c0043908190","var_name":"request_date","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"639249153667881b3c67496012019849","prj_uid":"27544921766757a332a78c0043908190","var_name":"disputetype","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"612221992667881c60406f9007563854","prj_uid":"27544921766757a332a78c0043908190","var_name":"party_involved","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"42731883566788a40d0dd91021856204","prj_uid":"27544921766757a332a78c0043908190","var_name":"agreement_status","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"35370187366788b8132b9d6010584569","prj_uid":"27544921766757a332a78c0043908190","var_name":"date_resolution","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"15355214766788607095608087297719","prj_uid":"27544921766757a332a78c0043908190","var_name":"resolution_status","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"8853789366676885025ae69084689116","prj_uid":"27544921766757a332a78c0043908190","var_name":"textareaVar002","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":[],"inp_doc_uid":"","var_uid_old":"8853789366676885025ae69084689116","var_name_old":"textareaVar002","prj_uid_old":"27544921766757a332a78c0043908190"},{"var_uid":"957748976667884594ece53065968267","prj_uid":"27544921766757a332a78c0043908190","var_name":"ows_url","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
