      <record>
        <dyn_uid>9669253456681bfb0c02899007591430</dyn_uid>
        <dyn_title>customersurveylot</dyn_title>
        <dyn_description></dyn_description>
        <pro_uid>27544921766757a332a78c0043908190</pro_uid>
        <dyn_type>xmlform</dyn_type>
        <dyn_filename><![CDATA[27544921766757a332a78c0043908190/9669253456681bfb0c02899007591430]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"customersurveylot","description":"","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"9669253456681bfb0c02899007591430","name":"customersurveylot","description":"","mode":"edit","script":{"type":"js","code":"var owsUrl = ($('#ows_url').getValue());\nvar coords = ($('#aoi_coords').getValue()).split(' ');\n\n\nvar osmLayer = new ol.layer.Tile({\n    className: 'bw100',\n    source: new ol.source.OSM()\n});\n\n\nvar districtLayer = new ol.layer.Tile({\n    title: 'Districts',\n    source: new ol.source.TileWMS({\n        url: owsUrl,\n        params: {\n            'LAYERS': 'district',\n            serverType: 'mapserver'\n        }\n    })\n});\n\n\n// Vector layer for the boundary of the district where the survey takes place\nvar wfsParams = '&typename=wfms:survey_district' +\n                '&service=WFS&version=1.1.0&request=GetFeature' +\n                '&outputFormat=geojson&srsname=EPSG:3857';\nvar surveyAreaLayer = new ol.layer.Vector({\n    title: 'Survey District',\n    source: new ol.source.Vector({\n        format: new ol.format.GeoJSON(),\n        url: owsUrl + wfsParams + '&COORDS=' + coords[0] + ' ' + coords[1]\n    }),\n    style: new ol.style.Style({\n        stroke: new ol.style.Stroke({\n            color: 'rgb(100, 149, 237)',\n            width: 2.5\n        }),\n        fill: new ol.style.Fill({\n            color: 'rgba(100, 149, 237, 0.1)'\n        })\n    })\n});\n\n\n// Compute the survey district's bounding box and store the value in the 'ows_extent' variable\nvar districtCode, recenter = true;\nsurveyAreaLayer.getSource().on('change', function(){\n    if (recenter){\n        var extent = this.getExtent();\n        navmap.getView().setCenter(ol.extent.getCenter(extent));\n        navmap.getView().fit(extent, navmap.getSize());\n        navmap.getView().setZoom(navmap.getView().getZoom() - 0.3);\n        $(\"#ows_extent\").setValue((navmap.getView().calculateExtent(navmap.getSize())).toString());\n\n        $(\"#district_name\").setValue(this.getFeatures()[0].getProperties().district_name);\n        districtCode = this.getFeatures()[0].getProperties().district_code;\n        recenter = false;\n    }\n});\n\n\n// Vector layer for survey data\nvar lotLayer = new ol.layer.Vector({\n    title: 'Survey',\n    source: new ol.source.Vector(),\n    style: new ol.style.Style({\n        fill: new ol.style.Fill({\n            color: 'rgba(166, 77, 255, 0.1)'\n        }),\n        stroke: new ol.style.Stroke({\n            color: 'rgb(166, 77, 255)',\n            width: 2.5\n        }),\n        zIndex: 10\n    })\n});\n\n\nvar navmap = new ol.Map({\n    layers: [osmLayer, districtLayer, surveyAreaLayer, lotLayer],\n    target: 'navmap_div',\n    view: new ol.View({\n        extent: ol.proj.transformExtent([6.6104, 52.1542, 7.1531, 52.2922], 'EPSG:4326', 'EPSG:3857'),\n        center: ol.proj.transform([6.8819, 52.2232], 'EPSG:4326', 'EPSG:3857'),\n        zoom: 12, minZoom: 11, maxZoom: 16\n    })\n});\n\n\n// Define a interaction object for on-screen digitizing\nvar drawLot = new ol.interaction.Draw({\n    source: lotLayer.getSource(),\n    type: 'Polygon'\n});\ndrawLot.on('drawstart', function(){\n    lotLayer.getSource().clear();\n});\nnavmap.addInteraction(drawLot);\n\n\n// Enable snaping of the surveyed lot inputs to the district boundary\nnavmap.addInteraction(new ol.interaction.Snap({\n    source: surveyAreaLayer.getSource(),\n}));\n\n\n// Specifying what to do when a lot survey is completed\nvar lotSize;\nlotLayer.getSource().on('addfeature', function(){\n    var surveyCoords = $.extend(true, {}, this.getFeatures()[0].getGeometry());\n    surveyCoords = surveyCoords.transform('EPSG:3857','EPSG:4326');\n    $(\"#survey_coords\").setValue(JSON.stringify(surveyCoords.getCoordinates()[0]));\n\n    lotSize = ol.sphere.getArea(this.getFeatures()[0].getGeometry());\n    $(\"#lot_size\").setValue((Math.round((lotSize/10000)*100)/100).toString() + ' Hectares.');\n\n    $(\"#selected_lot\").setValue(districtCode + '-s' + (1 + Math.floor(Math.random() * 100)));\n});\n"},"language":"en","externalLibs":"https://gip.itc.utwente.nl/exercises/styles/wfms.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.js\n","printable":false,"items":[[{"type":"title","id":"t__survey_form","label":"Selecting Disputed Lot","ariaLabel":"","colSpan":12}],[{"type":"textarea","variable":"description","var_uid":"54095880066788217158ee6008914338","dataType":"string","protectedValue":false,"id":"description","name":"description","label":"Request Description","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"view","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"5","var_name":"description","colSpan":12}],[{"colSpan":2},{"type":"panel","id":"map_panel","content":"<div id=\"navmap_div\" style=\"height:500px; border:1px solid #aaa; padding:5px;\"></div>","border":"1px","colSpan":10}],[{"type":"text","variable":"aoi_coords","var_uid":"83679298666788172c6de47038379881","dataType":"string","protectedValue":false,"id":"aoi_coords","name":"aoi_coords","label":"Aoi coordinates","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"aoi_coords","colSpan":6},{"type":"datetime","variable":"request_date","var_uid":"7200002596679b83628a544074990760","dataType":"datetime","protectedValue":false,"id":"request_date","name":"request_date","label":"Request Date","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"view","format":"YYYY-MM-DD","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"request_date","colSpan":6}],[{"type":"subtitle","id":"t__survey_details","label":"Survey Details","ariaLabel":"","colSpan":12}],[{"type":"text","variable":"selected_lot","var_uid":"98738357766788d1129efc4077364267","dataType":"string","protectedValue":false,"id":"selected_lot","name":"selected_lot","label":"Customer AOI","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"selected_lot","colSpan":6},{"type":"text","variable":"lot_size","var_uid":"21332748166788d35a76836084948598","dataType":"string","protectedValue":false,"id":"lot_size","name":"lot_size","label":"Lot Size:","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","db