{"name":"LandDisputeComplaintForms","description":"an application from the complainant to initiate the whole process","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"72469228166758e0fde83e7050239204","name":"LandDisputeComplaintForms","description":"an application from the complainant to initiate the whole process","mode":"edit","script":{"type":"js","code":"// Determining & setting the current date value\n$(\"#request_date\").setValue(new Date().toJSON().slice(0,10));\n\n// OGC service URL (WFMS's exercise endpoint)\nvar owsUrl = 'https://gip.itc.utwente.nl/services/zones?';\n$(\"#ows_url\").setValue(owsUrl);\n\n// OpenStreetMap as a base layer\nvar osmLayer = new ol.layer.Tile({\n    className: 'bw40',\n    source: new ol.source.OSM()\n});\n\n// Layer to display the city's boundary\nvar cityLayer = new ol.layer.Image({\n    title: 'City',\n    source: new ol.source.ImageWMS({\n        url: owsUrl,\n        params: {\n            'LAYERS': 'city',\n            'STYLES': 'blackline',\n            serverType: 'mapserver'\n        }\n    })\n});\n\n// Creating the map object, adding the layers, and setting the map's center, zoom level & extent\nvar navmap = new ol.Map({\n    target: 'navmap_div',\n    layers: [osmLayer, cityLayer],\n    view: new ol.View({\n        extent: ol.proj.transformExtent([6.6104, 52.1542, 7.1531, 52.2922], 'EPSG:4326', 'EPSG:3857'),\n        center: ol.proj.transform([6.8819, 52.2232], 'EPSG:4326', 'EPSG:3857'),\n        zoom: 11.5, minZoom: 11, maxZoom: 16\n    })\n});\n\n// Specifying a layer to store user created input\nvar aoiLayer = new ol.layer.Vector({\n    source: new ol.source.Vector(),\n    style: new ol.style.Style({\n        stroke: new ol.style.Stroke({\n            color: 'rgb(230, 0, 119)',\n            width: 2\n        }),\n        fill: new ol.style.Fill({\n            color: 'rgba(230, 0, 119, 0.4)'\n        })\n    })\n});\nnavmap.addLayer(aoiLayer);\n\n// Creating an interaction object for on-screen digitizing\nvar drawPolygon = new ol.interaction.Draw({\n    source: aoiLayer.getSource(),\n    type: 'Polygon'\n});\ndrawPolygon.on('drawstart', function() {\n    // Do not clear previous features\n});\nnavmap.addInteraction(drawPolygon);\n\n// Creating an interaction object to collect point data from the user\nvar point = new ol.interaction.Draw({\n    source: aoiLayer.getSource(),\n    type: 'Point',\n});\npoint.on('drawstart', function(){\n    aoiLayer.getSource().clear();\n});\nnavmap.addInteraction(point);\n\n// Specifying what to do when user input is detected\naoiLayer.getSource().on('addfeature', function(event){\n    var feature = event.feature;\n    var coords = feature.getGeometry().clone().transform('EPSG:3857','EPSG:4326').getCoordinates();\n    $(\"#aoi_coords\").setValue(coords[0][0] + ' ' + coords[0][1]);\n\n    // Layer to display district boundaries\n    var districtLayer = new ol.layer.Tile({\n        title: 'Districts',\n        source: new ol.source.TileWMS({\n            url: owsUrl,\n            params: {\n                'LAYERS': 'district',\n                serverType: 'mapserver'\n            }\n        })\n    });\n    navmap.addLayer(districtLayer);\n\n    // Vector layer containing the lots of a given district\n    var wfsParams = '&typename=wfms:lot&' +\n                    'service=WFS&version=1.1.0&request=GetFeature' +\n                    '&outputFormat=geojson&srsname=EPSG:3857';\n    var lotLayer = new ol.layer.Vector({\n        title: 'Lots',\n        source: new ol.source.Vector({\n            format: new ol.format.GeoJSON(),\n            url: owsUrl + wfsParams + '&COORDS=' + coords[0] + ' ' + coords[1]\n        }),\n        style: new ol.style.Style({\n            stroke: new ol.style.Stroke({\n                color: 'rgb(100, 149, 237)',\n                width: 2.5\n            }),\n            fill: new ol.style.Fill({\n                color: 'rgba(100, 149, 237, 0.1)'\n            })\n        })\n    });\n    navmap.addLayer(lotLayer);\n\n    // Ensure lots are visible and selectable from the start\n    lotLayer.getSource().once('change', function(){\n        var extent = lotLayer.getSource().getExtent();\n        navmap.getView().fit(extent, { size: navmap.getSize(), maxZoom: 16 });\n    });\n\n    // Define an interaction object to select lots\n    var lotSelection = new ol.interaction.Select({\n        layers: [lotLayer],\n        style: function(feature){\n            return new ol.style.Style({\n                fill: new ol.style.Fill({\n                    color: 'rgba(166, 77, 255, 0.1)'\n                }),\n                stroke: new ol.style.Stroke({\n                    color: 'rgb(166, 77, 255)',\n                    width: 2.5\n                }),\n                text: new ol.style.Text({\n                    text: feature.getProperties().lot_code,\n                    textAlign: 'center',\n                    font: 'Normal 16px Calibri,sans-serif',\n                    overflow: true,\n                    fill: new ol.style.Fill({color: 'rgb(128, 0, 255)'}),\n                    stroke: new ol.style.Stroke({color: 'rgba(255, 255, 255, 0.5)', width: 3})\n                }),\n                zIndex: 10\n            });\n        }\n    });\n    navmap.addInteraction(lotSelection);\n\n    // Specifying what to do when lot is selected/unselected\n    lotSelection.getFeatures().on('add', function(evt){\n        $(\"#selected_lot\").setValue(evt.element.getProperties().lot_code);\n        $(\"#district_name\").setValue(evt.element.getProperties().district_name);\n        var lotSize = evt.element.getProperties().lot_size;\n        $(\"#lot_size\").setValue((lotSize/10000).toFixed(1) + ' Hectares.');\n    });\n    lotSelection.getFeatures().on('remove', function(evt){\n        $(\"#selected_lot\").setValue('');\n        $(\"#lot_size\").setValue('');\n    });\n});"},"language":"en","externalLibs":"https://gip.itc.utwente.nl/exercises/styles/wfms.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.css,\nhttps://gip.itc.utwente.nl/libraries/OpenLayers/v6/ol.js\n","printable":false,"items":[[{"type":"title","id":"t__application_form","label":"Land Dispute Complaint Forms","ariaLabel":"","colSpan":12}],[{"type":"subtitle","id":"t__customer_details","label":"Applicant Information","ariaLabel":"","colSpan":12}],[{"type":"text","variable":"customer_name","var_uid":"7286580326678491e477188026375408","dataType":"string","protectedValue":false,"id":"Customer_name","name":"customer_name","label":"Full Name ","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"customer_name","colSpan":6},{"type":"text","variable":"customer_email","var_uid":"306331223667848e35da5c1088790820","dataType":"string","protectedValue":false,"id":"Customer_email","name":"customer_email","label":"Email Address","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"view","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"customer_email","colSpan":6}],[{"type":"text","variable":"house_address","var_uid":"9353007536678495cb6a974035063428","dataType":"string","protectedValue":false,"id":"house_address","name":"house_address","label":"House Address","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCa